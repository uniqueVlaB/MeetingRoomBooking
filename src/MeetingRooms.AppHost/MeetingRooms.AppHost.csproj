<Project Sdk="Microsoft.NET.Sdk">

  <!--
    .NET Aspire AppHost: the development-time orchestrator. It starts the API and the Angular dev
    server together and wires the connection strings and secrets between them, against a local SQL
    Server instance rather than a Docker container; see the comment on the database resource in
    AppHost.cs for why.

    Note that this project is for local development only. Deployment targets Azure Web Apps via the
    GitHub Actions workflows in .github/workflows, not Aspire's container-based publishing.
  -->

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.3" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>meetingrooms-apphost</UserSecretsId>
    <!-- Generated Projects.* metadata is not documented; the rule would fail the build. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!--
      ASPIRE010 reports that the Aspire CLI bundle is not in use. It is an MSBuild warning raised by
      an imported .targets file, so TreatWarningsAsErrors (which applies to compiler warnings) never
      promoted it, and it was the one thing keeping the build from being genuinely clean.
      Suppressed rather than fixed because the features the bundle adds are ones this repository does
      not use: deployment goes through GitHub Actions to Azure Web Apps, not Aspire publishing.
    -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeetingRooms.Api\MeetingRooms.Api.csproj" />
  </ItemGroup>

</Project>
